rules_version = '2';

// Article thumbnails live in media/articles/. See docs/DB_SCHEMA.md.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSupportedImage() {
      return request.resource.contentType.matches('^image/(jpeg|png|webp)$');
    }

    function isWithinSizeLimit() {
      // 5 MiB
      return request.resource.size <= 5 * 1024 * 1024;
    }

    // One file directly inside media/articles/; sub-folders are not allowed.
    // Anyone can view a thumbnail; only signed-in journalists can write them.
    match /media/articles/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && isSupportedImage() && isWithinSizeLimit();
      allow delete: if isSignedIn();
    }

    // Everything else in the bucket is denied by default.
  }
}
